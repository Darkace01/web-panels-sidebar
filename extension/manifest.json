{
  "manifest_version": 2,
  "name": "Zen Sidebar",
  "version": "0.1.0",
  "description": "Vivaldi/Edge-style web panels: pin sites to an icon rail and open them beside the page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-sidebar@beeresoftwares.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "search",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": { "scripts": ["lib/store.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/opener.js"],
      "run_at": "document_start"
    }
  ],
  "sidebar_action": {
    "default_title": "Zen Sidebar",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle Zen Sidebar"
    },
    "add-current-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Add the current page as a panel"
    }
  }
}
