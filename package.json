{
  "name": "zen-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "Vivaldi/Edge-style web panel sidebar extension for Zen Browser",
  "scripts": {
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --overwrite-dest",
    "start": "web-ext run --source-dir extension --firefox \"C:\\\\Program Files\\\\Zen Browser\\\\zen.exe\"",
    "sign": "web-ext sign --source-dir extension --channel unlisted"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
